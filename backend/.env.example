# Empty credentials only. B implements config loading during backend setup.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Whole agent request deadline in seconds; no automatic model retries.
AGENT_TIMEOUT_SECONDS=30
# Relative paths resolve against backend/, not the caller's working directory.
ATTRACTIONS_PATH=data/attractions.json
TRIPS_PATH=data/trips.json
